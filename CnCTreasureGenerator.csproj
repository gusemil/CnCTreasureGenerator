<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- The treasure code is compiled to WebAssembly and runs in the browser, so the whole site is
       static files (wwwroot + _framework) that GitHub Pages can host. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>CnCTreasureGenerator</RootNamespace>
    <AssemblyName>CnCTreasureGenerator</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The treasure code is copied from the terminal app, which predates nullable reference types. -->
    <Nullable>disable</Nullable>
    <!-- Required by [JSExport] -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Culture data is not needed (numbers are formatted with the invariant culture) and makes the download smaller -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
